# Postgres. On Neon, DATABASE_URL is the pooled URL and DATABASE_URL_UNPOOLED the
# direct one (migrations need a direct connection). For local Postgres, set both
# to the same value, e.g. the docker-compose.yml database:
DATABASE_URL="postgresql://movie:movie@localhost:5432/movie_memory?schema=public"
DATABASE_URL_UNPOOLED="postgresql://movie:movie@localhost:5432/movie_memory?schema=public"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI — server-only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6.1-sol"
